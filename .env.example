# FX ML Trading System - Environment Variables
# Copy this file to .env and fill in your values

# OANDA Demo Account (get from https://www.oanda.com/demo-account/)
OANDA_API_KEY=your_oanda_demo_api_key_here
OANDA_ACCOUNT_ID=your_oanda_demo_account_id_here
OANDA_ENVIRONMENT=practice

# MLflow Tracking (optional - for managed MLflow)
MLFLOW_TRACKING_URI=https://your-mlflow-server.com

# Render Deployment (get from Render dashboard)
RENDER_API_KEY=your_render_api_key_here

# Alert Webhook (optional - Slack, Discord, etc.)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx